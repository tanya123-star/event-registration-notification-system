generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  OFFICER
  ADMIN
  DEV
}

enum NotificationAudience {
  ALL
  CLUB
}

enum OfficerPosition {
  PRESIDENT
}

enum EventStatus {
  DRAFT
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
  PUBLISHED
  CANCELLED
}

enum EventApprovalAction {
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
}

enum AttendanceMethod {
  QR
  MANUAL
}

enum TaskType {
  ATTENDANCE
  GENERAL
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  DONE
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  emailVerified          DateTime?
  allowExternalEmail     Boolean                 @default(false)
  name                   String
  image                  String?
  studentNumber          String?                 @unique
  role                   Role                    @default(STUDENT)
  officerPosition        OfficerPosition?
  isActive               Boolean                 @default(true)
  /// Legacy club membership. Read-only after the single-organization migration.
  clubId                 String?
  club                   Club?                   @relation(fields: [clubId], references: [id])
  createdAt              DateTime                @default(now())
  eventsCreated          Event[]                 @relation("EventCreator")
  eventApprovals         EventApproval[]         @relation("EventApprovalActor")
  registrations          Registration[]
  attendances            Attendance[]
  notificationsSent      Notification[]          @relation("NotificationSender")
  notificationReads      NotificationRead[]
  pendingAssignmentsMade PendingRoleAssignment[] @relation("AssignedBy")
  tasksAssigned          Task[]                  @relation("TaskAssignee")
  tasksCreated           Task[]                  @relation("TaskAssigner")
  attendanceRecorded     Attendance[]            @relation("AttendanceRecorder")
  accounts               Account[]
  sessions               Session[]
}

model PendingRoleAssignment {
  id                 String           @id @default(cuid())
  email              String           @unique
  role               Role
  officerPosition    OfficerPosition?
  allowExternalEmail Boolean          @default(false)
  /// Legacy club assignment. New invitations leave this null.
  clubId             String?
  club               Club?            @relation(fields: [clubId], references: [id])
  assignedById       String
  assignedBy         User             @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedAt         DateTime         @default(now())
}

model Club {
  id                 String                  @id @default(cuid())
  name               String                  @unique
  shortName          String?                 @unique
  createdAt          DateTime                @default(now())
  members            User[]
  events             Event[]
  notifications      Notification[]
  pendingAssignments PendingRoleAssignment[]
}

model Event {
  id                   String          @id @default(cuid())
  title                String
  description          String?
  venue                String
  startAt              DateTime
  endAt                DateTime?
  /// Legacy club host. New events leave this null.
  clubId               String?
  club                 Club?           @relation(fields: [clubId], references: [id])
  status               EventStatus     @default(DRAFT)
  mechanics            String?
  programFlow          String?
  requirements         String?
  publishedAt          DateTime?
  capacity             Int?
  registrationClosesAt DateTime?
  createdById          String
  createdBy            User            @relation("EventCreator", fields: [createdById], references: [id])
  createdAt            DateTime        @default(now())
  approvals            EventApproval[]
  registrations        Registration[]
  attendances          Attendance[]
  notifications        Notification[]
  tasks                Task[]

  @@index([status, startAt, id])
}

model EventApproval {
  id         String              @id @default(cuid())
  eventId    String
  event      Event               @relation(fields: [eventId], references: [id])
  actorId    String
  actor      User                @relation("EventApprovalActor", fields: [actorId], references: [id])
  action     EventApprovalAction
  fromStatus EventStatus
  toStatus   EventStatus
  comment    String?
  createdAt  DateTime            @default(now())

  @@index([eventId, createdAt])
}

model Registration {
  id          String             @id @default(cuid())
  eventId     String
  event       Event              @relation(fields: [eventId], references: [id])
  studentId   String
  student     User               @relation(fields: [studentId], references: [id])
  reference   String             @unique
  status      RegistrationStatus @default(REGISTERED)
  createdAt   DateTime           @default(now())
  cancelledAt DateTime?

  @@unique([eventId, studentId])
  @@index([studentId, status])
  @@index([eventId, status])
}

model Attendance {
  id           String           @id @default(cuid())
  eventId      String
  event        Event            @relation(fields: [eventId], references: [id])
  studentId    String
  student      User             @relation(fields: [studentId], references: [id])
  checkedInAt  DateTime         @default(now())
  photoUrl     String
  method       AttendanceMethod @default(QR)
  recordedById String?
  recordedBy   User?            @relation("AttendanceRecorder", fields: [recordedById], references: [id])

  @@unique([eventId, studentId])
  @@index([eventId, checkedInAt])
}

model Task {
  id           String     @id @default(cuid())
  eventId      String?
  event        Event?     @relation(fields: [eventId], references: [id])
  type         TaskType
  assigneeId   String
  assignee     User       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assignedById String
  assignedBy   User       @relation("TaskAssigner", fields: [assignedById], references: [id])
  dueAt        DateTime?
  status       TaskStatus @default(ASSIGNED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([assigneeId, status])
  @@index([eventId, type])
  @@index([assignedById])
}

model Notification {
  id          String               @id @default(cuid())
  title       String
  body        String
  audience    NotificationAudience
  eventId     String?
  event       Event?               @relation(fields: [eventId], references: [id])
  /// Legacy club audience. New notifications write null.
  clubId      String?
  club        Club?                @relation(fields: [clubId], references: [id])
  createdById String
  createdBy   User                 @relation("NotificationSender", fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())
  reads       NotificationRead[]

  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

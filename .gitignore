# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (standard approach: committed .env.example template, ignored local .env)
.env*
!.env.example
secrets/

# vercel
.vercel

# storybook
storybook-static
*storybook.log

# typescript
*.tsbuildinfo
next-env.d.ts

# generated Prisma client
/src/generated/prisma/

.direnv/

# AI agent tooling
/.opencode/
.superpowers/


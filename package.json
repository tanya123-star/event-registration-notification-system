{
  "name": "event-registration-notification-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/.eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-strategy content --cache-location node_modules/.cache/.eslintcache",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\" --cache && pnpm prisma format",
    "format:check": "prettier --check .",
    "validate": "pnpm format && pnpm lint && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:browser": "vitest run --project storybook",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@internationalized/date": "^3.12.4",
    "@prisma/adapter-pg": "^7.10.0",
    "@zxing/browser": "^0.2.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.7",
    "next": "16.4.1",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@fontsource/roboto": "^5.3.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@prisma/client": "^7.10.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-storybook": "^10.6.1",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "storybook": "^10.6.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
